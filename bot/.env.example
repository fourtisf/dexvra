# ── Dexvra Telegram Bot — copy to .env (gitignored; NEVER commit real values) ──

# ── Telegram ─────────────────────────────────────────────────────────────────
BOT_TOKEN=                       # @BotFather token for the main bot
ADMIN_BOT_TOKEN=                 # @BotFather token for the admin/template-editor bot (optional)
ANNOUNCE_CHANNEL=@dexvraio        # announcement channel (bot must be admin)
TRENDING_CHANNEL=@dexvratrending  # trending channel
LISTING_CHANNEL=@dexvralisting    # listing-alert channel
# Community group. Every listing is FORWARDED here from LISTING_CHANNEL, so the
# post keeps its premium emoji and carries a "from Dexvra Listing Alerts" header.
# The bot must be a member of the group. Set it EMPTY to turn the mirror off.
GROUP_CHAT=@dexvragroup
LOG_CHANNEL=                      # optional: channel id for visitor + event logs (/start, purchases)
# Optional second channel for warnings and errors. Leave blank and they land in
# LOG_CHANNEL alongside the visitor/purchase feed; set it and that feed stays clean.
ERROR_CHANNEL=
# Hour (UTC) for the daily 💚 health heartbeat to ERROR_CHANNEL. Its ABSENCE is
# the alert: an in-process monitor cannot report its own death, so a missing
# line means the bot is down. Default 1 = 08:00 WIB.
HEALTH_HEARTBEAT_HOUR_UTC=1
PK_CHANNEL=                       # optional: PRIVATE channel id for temp-wallet private-key backups (bot must be admin)
ADMIN_IDS=                        # comma-separated numeric Telegram user ids (these pay 0 / test free)

# ── Token logo → animated custom-emoji packs (optional) ──────────────────────
# Each listing's logo becomes an animated custom emoji in a per-token pack
# ("SYMBOL by @dexvralisting"), shown inline in channel posts via GramJS.
# Packs are owned by the ADMIN bot; needs an anchor user that has /start'ed it.
# TOKEN_PACK_BOT_TOKEN=           # defaults to ADMIN_BOT_TOKEN
# TOKEN_PACK_USER_ID=             # defaults to the first ADMIN_IDS entry
# TOKEN_PACK_TITLE_SUFFIX=        # defaults to " by @dexvralisting"
ADMIN_USERNAMES=                  # comma-separated @usernames (case-insensitive)

# ── Premium emoji (GramJS / MTProto) ─────────────────────────────────────────
# Channel posts are sent from a Telegram PREMIUM user account so premium custom
# emoji render animated. 1) create API creds at https://my.telegram.org/apps
# (log in with the premium account), 2) run `node scripts/gramjs-login.js` once
# on the server, 3) make the account able to post in all three channels.
# Without these the bot falls back to Bot API (plain unicode emoji) — no outage.
API_ID=                           # from my.telegram.org/apps
API_HASH=                         # from my.telegram.org/apps
GRAMJS_SESSION_FILE=              # default: <bot>/session.txt (created by the login script)
GRAMJS_ENABLED=1                  # set 0 to force Bot API posting
# (PREMIUM_EMOJI was removed: the built-in premium IDs were a third-party
# fourtis pack and rendered fourtis branding. Defaults are plain unicode;
# paste your OWN premium emoji into templates via @dexvraadminbot instead.)

# ── Dexvra web app (internal API) ────────────────────────────────────────────
SITE_URL=https://dexvra.io
DEXVRA_API_BASE=http://127.0.0.1:3005   # where the Next.js app listens (same VPS)
INTERNAL_API_TOKEN=               # MUST equal the web app's INTERNAL_API_TOKEN (>= 24 chars)

# ── Payment (temp wallet + poll) ─────────────────────────────────────────────
PAYMENT_POLL_MS=3000              # balance poll interval (clamped 1500–10000)
PAYMENT_TIMEOUT_MS=300000         # give up polling after this (5 min)
PAYMENT_TOLERANCE_PCT=0           # accept payments this % under quote (dust tolerance)

# RPC endpoints — public defaults are baked in; override for reliability/limits.
RPC_ETHEREUM=
RPC_BSC=
RPC_BASE=
RPC_ROBINHOOD=
RPC_SOLANA=
RPC_TRON=
RPC_TON=
TON_API_KEY=                      # toncenter.com API key (recommended for TON)

# ── Treasury (sweep destinations) ────────────────────────────────────────────
# After a payment clears, funds sweep to these. Leave a chain BLANK to skip the
# sweep for it (funds stay in the per-order temp wallet, whose key is stored in
# .keys/). Set these before going live.
TREASURY_EVM=                     # one address for ethereum / bsc / base / robinhood
TREASURY_SOL=
TREASURY_TRON=
TREASURY_TON=

# ── Temp-wallet key storage ──────────────────────────────────────────────────
# WALLETS_DIR=./.keys
WALLET_ENC_KEY=                   # 64-hex (32-byte) AES-256-GCM key to encrypt stored keys at rest

# ── MongoDB durable mirror (optional; recommended for production) ─────────────
# When set, all bot state (the /start audience, orders, templates, group +
# banner config, dedup latches) is mirrored to MongoDB so it survives a VPS
# reset / container replace instead of living only on local disk. Reads still
# use local files; at boot any store missing on disk is restored from Mongo.
# Leave BLANK to run on local files only (no outage). Point BOTH bots (main +
# admin) at the SAME MONGO_URI so they share one durable store.
MONGO_URI=                        # e.g. mongodb+srv://user:pass@cluster.mongodb.net/dexvra
# MONGO_DB=dexvra                 # optional; defaults to the db name in MONGO_URI

# ── Twitter / X — AUTO-POSTING ───────────────────────────────────────────────
# Every LISTING — paid and free auto-listing — plus banner ads, rank-up and pump
# alerts is tweeted from the account below. Trending Token and the Top Gainers
# board are NOT (see the switches further down). Leave the four keys blank and
# the whole X path stays OFF — the bot runs normally, it just never tweets, and
# it says so once at boot.
#
# ── THE 4 KEYS THE BOT NEEDS (all four, from the SAME app) ────────────────────
# console.x.com → your project → your app (e.g. "DexvraListing") → Keys and tokens
#
#   X_API_KEY         = OAuth 1.0a  "Consumer Key"          (shown as API Key)
#   X_API_KEY_SECRET  = OAuth 1.0a  "Consumer Secret"       (shown as API Key Secret)
#   X_ACCESS_TOKEN    = OAuth 1.0a  "Access Token"          ← tap Generate
#   X_ACCESS_SECRET   = OAuth 1.0a  "Access Token Secret"   ← same Generate
#
# BEFORE generating the access token, open "User authentication settings" and set
# App permissions to **Read and write**. A token generated while the app was
# Read-only keeps that scope forever and every tweet fails with 403 — if you
# already generated one, change the permission and REGENERATE it.
#
# NOT USED (do not paste them here): the Bearer Token (read-only app auth) and
# the OAuth 2.0 Client ID / Client Secret. Posting on behalf of an account uses
# OAuth 1.0a, and v1 media upload accepts nothing else.
#
# Check it before you trust it:  npm run x:check       (verifies + names the handle)
#                                npm run x:check -- --tweet   (posts a real test tweet)
X_ENABLED=1                      # 0 = force every X post off, keys or not
X_LISTING_HANDLE=dexvralisting   # the account these keys belong to (no @)
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Per-source switches. @dexvralisting is the LISTING feed, so the two products
# that are not listings ship OFF — set either to 1 to turn it on, no deploy.
X_AUTOLIST_ENABLED=1             # tweet FREE auto-listings too, not just paid ones
X_TRENDING_ENABLED=0             # OFF: Trending Token is its own product, announced in @dexvratrending
X_GAINERS_ENABLED=0              # OFF: the Top Gainers board is posted by hand from @dexvraadminbot
X_RANKUP_ENABLED=0               # OFF: fires per token on every climb — too repetitive for the feed
# Pump alerts have no switch of their own (PUMP_ENABLED covers the whole feature).
# They fire ONCE per token, ever, and are only tweeted when the token's listing
# tweet is known — the pump tweet QUOTES it, so it always reads as a follow-up.
X_POST_TIMEOUT_MS=30000          # how long a post waits for X before going out without its X link
                                 # (raise it if you use long animated banners — video is transcoded by X)

# OPTIONAL second account, only for banner ads. Leave BLANK for the normal
# one-account setup — banner ads then go out from the listing account above.
X_HANDLE=dexvraio                # the @handle named in the banner-ad copy
X_O_API_KEY=
X_O_API_KEY_SECRET=
X_O_ACCESS_TOKEN=
X_O_ACCESS_SECRET=

# ── Background services ──────────────────────────────────────────────────────
TRENDING_POST_MS=300000           # trending list refresh cadence
TRENDING_SWEEP_MS=60000           # clear expired trending slots
PUMP_CHECK_MS=180000              # pump-alert poll cadence
PUMP_ENABLED=1

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_WINDOW=3000
RATE_LIMIT=20

# ── Top Gainers banner ───────────────────────────────────────────────────────
# Nothing to set here: the channel, layout, daily time/timezone and filters all
# live in the admin panel (@dexvraadminbot → 📊 Banner Top Gainers), persisted in
# data/gainersBanner.json so a change needs no redeploy. The daily auto-post ships
# OFF. These two only exist to re-tune the pollers:
GAINERS_POLL_MS=3000              # how often the main bot picks up a queued banner
GAINERS_DAILY_CHECK_MS=30000      # how often the daily-post clock is checked

# ── Admin broadcast (compose in @dexvraadminbot → delivered by the main bot) ──
BROADCAST_RATE=20          # messages/sec (Telegram allows ~30/s to distinct users; max 28)
BROADCAST_CONCURRENCY=8    # parallel in-flight sends
BROADCAST_POLL_MS=5000     # how often the main bot picks up a queued broadcast
